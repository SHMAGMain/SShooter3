#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aColor;

uniform float ratio;
uniform vec2 winSize;
uniform mat4 model;

out vec3 color;

void main()
{
    vec4 v = model * vec4(aPos.x, aPos.y, aPos.z, 1.0);
    v.y *= ratio;

    gl_Position = v;
    color = aColor;
}
