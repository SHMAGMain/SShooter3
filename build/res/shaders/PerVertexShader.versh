#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec3 aColor;

uniform float ratio;
uniform vec2 winSize;

uniform mat4 model;
uniform mat4 cam;
uniform mat4 per;
uniform mat4 mNormal;
uniform mat4 view;

out vec3 color;

void main()
{
    vec4 v = per * view * model * vec4(aPos.x, aPos.y, aPos.z, 1.0);
    v.y *= ratio;

    gl_Position = v;


    vec4 n = mNormal * vec4(aNormal, 1.0f);
    vec3 normal = vec3(n.x, n.y, n.z);

    vec3 lightDir = normalize(vec3(3, -2, -1));
    float a = dot(lightDir, normal) * 0.5;

    vec3 amb = aColor * 0.8;

    color = amb + (aColor * a);
}
